        {
          "name": "Auth - Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
              "exec": [
                "const timestamp = Date.now();",
                "const uniqueEmail = `postman+${timestamp}@demo.local`;",
                "const generatedPassword = `Demo!${timestamp}`;",
                "pm.environment.set('email', uniqueEmail);",
                "pm.environment.set('password', generatedPassword);",
                "pm.environment.unset('token');"
              ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
              "exec": [
                "(() => {",
                "  let body = null;",
                "  try { body = pm.response.json(); } catch (err) { body = null; }",
                "  if (body && body.access_token) {",
                "    pm.environment.set('token', body.access_token);",
                "  }",
                "})();"
              ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"org_name\": \"Postman Org\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
